@model CateringAgency.Domain.ComboMenuBo

<div class="card mb-2">
    @using (Html.BeginForm("AddComboMenuToCart", "Menu", FormMethod.Post))
    {
        @Html.HiddenFor(t => t.ComboMenuId)
        <div class="row align-items-center">

            <div class="col-3">
                <img src="~/Images/ketering-main-page.jpg" alt="@Model.Name" style="max-width: 100%; height: auto; margin: 10px" />
            </div>

            <div class="col-3">
                <div style="word-wrap: break-word;">
                        @if (Model.DiscountIsValid)
                        {<h5 class="text-warning fw-bold">(@Model.DiscountAmount.ToString()% OFF!)</h5>}
                    <h5>
                        @Model.Name
                    </h5>
                    @if (Model.HasItems())
                    {
                        <p class="text-muted">
                            @Model.ListOfItems
                        </p>
                    }
                </div>
            </div>

            <!--List of combo menu items-->
            @*
                <div class="col text-center">
                    <h5>Items</h5>
                    <p class="text-muted"><b>@Model.ListOfItems</b></p>
                </div>
            *@

            <!-- Base price and selling price -->
            <div class="col text-center">
                <h5>Price</h5>
                @if (Model.DiscountIsValid)
                {
                    <h5 class="text-success text-decoration-line-through">@Model.BasePriceString RSD</h5>
                }
                <h4 class="text-success"><b>@Model.SellingPriceString RSD</b></h4>
            </div>

            <div class="col px-auto text-center">
                <h6>Quantity</h6>
                @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control mb-2 mx-auto w-50", @min = "1" } })
                <button type="submit" class="btn btn-outline-success"><i class="bi bi-cart-plus"> Add to cart</i></button>
            </div>

        </div>
    }
</div>

