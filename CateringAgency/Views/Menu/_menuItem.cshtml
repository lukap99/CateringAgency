@model CateringAgency.Domain.FoodBo

<div class="card mb-2">
    @using (Html.BeginForm("AddToCart", "Menu", FormMethod.Post))
    { 
        @Html.HiddenFor(t => t.FoodId)

        <div class="row align-items-center">

            <div class="col-2">
                <img src="~/Images/ketering-main-page.jpg" alt="@Model.Name" style="max-width: 100%; height: auto; margin: 10px" />
            </div>

            <div class="col-3">
                <div class="card-body" style="word-wrap: break-word;">
                    <h5 class="card-title">
                        @Model.Name
                        @if (Model.Discount.IsValid)
                        {
                            <br><span class="text-warning">(@Model.Discount.DiscountAmount.ToString()% OFF!)</span>
                        }
                    </h5>
                        @if (Model.Ingredients != null)
                        {
                            <p class="text-muted">
                                @Model.Ingredients.ToString()
                            </p>
                        }
                </div>
            </div>

            <div class="col text-center">
                <h6>Category
                    @if (Model.FoodCategory.CategoryDiscount.IsValid)
                    {
                    <br>
                    <span class="text-warning">(@Model.FoodCategory.CategoryDiscount.DiscountAmount.ToString()% OFF!)</span>
                    }
                </h6>
                <p class="text-muted">@Model.FoodCategory.Name.ToString()</p>
            </div>

            <div class="col-auto text-center">
                <h6>Quantity</h6>
                <p>@Model.UnitOfMeasurement.ToString()</p>
                <!-- Parameter: "Amount" -->
                @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control", @min="1", @style="width:90px;" }} )
            </div>  

            <div class="col text-center">
                @if (Model.Discount.IsValid || Model.FoodCategory.CategoryDiscount.IsValid)
                {
                 <h6 class="text-muted text-decoration-line-through">@Model.BasePriceString RSD</h6>
                }
                <h5 class="text-success"><b>@Model.SellingPriceString RSD</b></h5>
                <button type="submit" class="btn btn-outline-success"><i class="bi bi-cart-plus"> Add to cart</i></button>
            </div>

        </div>
     }
</div>