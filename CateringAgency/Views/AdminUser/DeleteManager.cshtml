@model CateringAgency.Domain.UserBo

@{
    ViewBag.Title = "Delete manager";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-xxl-4 px-4 py-3">
    <div class="row px-0 py-0">

        <!-- Card start -->
        <div class="card mb-2 px-0 py-0">

            <div class="row">
                <img src="~/Images/create_header.jpg">
            </div>

            <div class="row g-0 d-flex align-items-center">

                <div class="col-lg">
                    <div class="card-body py-4 px-md-5">

                        <h4>Are you sure you want to delete manager?</h4>
                        <hr class="solid" />
                        <h5>Ime: <span class="text-muted">@Model.FirstName @Model.LastName</span></h5>
                        <h5>Username: <span class="text-muted">@Model.Username</span></h5>
                        <h5>E-mail: <span class="text-muted">@Model.Email</span></h5>
                        <hr class="solid" />

                        <div class="text-center">
                            <!-- submit -->
                            <a href="@Url.Action("ConfirmDeleteManager", "AdminUser", new { id = Model.UserId })" class="btn btn-danger">Delete</a>
                            <a href="@Url.Action("Managers", "AdminUser")" class="btn btn-primary">Back</a>
                        </div>

                    </div>
                </div>

            </div>

        </div>
        <!-- Card end -->

    </div>
</div>