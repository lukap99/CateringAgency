@{
    ViewBag.Title = "Home Page";
}

<div class="container col-xxl-8 px-4 py-5">
    <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
        <div class="col-10 col-sm-8 col-lg-6">
            <img src="~/Images/catering-example.png" class="d-block mx-lg-auto img-fluid" alt="Bootstrap Themes" width="700" height="500" loading="lazy">
        </div>
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold lh-1 mb-3 text-primary">Ketering Služba</h1>
            <br />
            <p class="lead">Sa ove aplikacije možete naručiti dostavu hrane za razne proslave i događaje, rođendani, slave, žurke i slično. Za svakih 500 RSD kojih potrošite na narudžbinu dobijate 
            <i>ketering poen</i> koji možete koristiti da ostvarite popuste za svaku naknadnu kupovinu! Da bi sakupljali i koristili poene, <a href="@Url.Action("Register", "Account")">napravite nalog.</a></p>
            
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a href="@Url.Action("Index", "Menu")" class="btn btn-primary btn-lg px-4 me-md-2">Menu</a>
                @if (Session["Firstname"] == null)
                {
                    <a href="@Url.Action("Login", "Account")">
                        <button type="button" class="btn btn-outline-secondary btn-lg px-4">Login</button>
                    </a>
                }

            </div>
        </div>
    </div>
</div>