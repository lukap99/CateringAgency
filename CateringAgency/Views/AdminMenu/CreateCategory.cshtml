@model CateringAgency.Domain.FoodCategoryBo

@{
    ViewBag.Title = "Create Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-xxl-4 px-4 py-3">
    <div class="row px-0 py-0">

        <!-- Card start -->
        <div class="card mb-2 px-0">
            <div class="row">
                <img src="~/Images/create_header.jpg" alt="Create category header image">
            </div>

            <div class="row g-0 d-flex align-items-center">
                <div class="col-lg">
                    <div class="card-body py-4 px-md-5">

                        @using (Html.BeginForm("CreateCategory", "AdminMenu", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <fieldset>
                                <legend><h4>Create new food category</h4></legend>

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <!-- Category Name -->
                                <div class="mb-3">
                                    @Html.LabelFor(model => model.Name, new { @class = "form-label" })
                                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control", placeholder = "e.g. Soups, Desserts" })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>

                                <!-- Discount Percentage (optional) -->
                                <div class="mb-3">
                                    <label class="form-label">Discount Percentage</label>
                                    <div class="input-group" style="max-width: 40%;">
                                        @Html.TextBox("CategoryDiscount.DiscountAmount", Model.CategoryDiscount?.DiscountAmount ?? 0,
                                            new { @min = "0", @max = "100", @type = "number", @class = "form-control", @step = "0.01" })
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <small class="form-text text-muted">Leave 0 if no discount applies to the whole category.</small>
                                </div>

                                <!-- Submit and Back -->
                                <div class="mt-4">
                                    <input type="submit" value="Create Category" class="btn btn-success">
                                    <a href="@Url.Action("Index", "AdminMenu")" class="btn btn-primary">Back</a>
                                </div>
                            </fieldset>
                        }

                    </div>
                </div>
            </div>
        </div>
        <!-- Card end -->

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}