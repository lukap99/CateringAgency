@model IEnumerable<CateringAgency.Domain.UserBo>

@{
    ViewBag.Title = "View registered users";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 1;
    int managersCount = Model.ToList().Count;
}

<main class="flex-fill">
    <div class="container col-xxl-8 px-4 py-5">
        <h2>Managers</h2>

        <form method="get" action="@Url.Action("Managers")" class="form-check-inline mb-3">

            <table class="table">
                <thead>
                    <tr>
                        <th><a href="@Url.Action("Managers", new { sortOrder = ViewBag.CurrentSort == "name_desc" ? "name_asc" : "name_desc", searchString = ViewBag.CurrentFilter, page = 1 })">Name</a></th>
                        <th><a href="@Url.Action("Managers", new { sortOrder = ViewBag.CurrentSort == "email_desc" ? "email_asc" : "email_desc", searchString = ViewBag.CurrentFilter, page = 1 })">Email</a></th>
                        <th>Username</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.LastName @m.FirstName</td>
                            <td>@m.Email</td>
                            <td>@m.Username</td>
                            <td>
                                <a href="@Url.Action("EditManager", new { id = m.UserId })" class="btn btn-sm btn-primary">Edit</a>
                                <a href="@Url.Action("DeleteManager", new { id = m.UserId })" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @Html.Partial("_Pagination", new ViewDataDictionary { { "ActionName", "Managers" } })
    </div>
</main>