@model IEnumerable<CateringAgency.Domain.UserBo>

@{
    ViewBag.Title = "View registered users";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 1;
    int usersCount = Model.ToList().Count;
}

<main class="flex-fill">
    <div class="container col-xxl-8 px-4 py-5">

        <h2>Registered Users</h2>


        <form method="get" action="@Url.Action("Users")" class="form-inline mb-3">
            <div class="input-group">
                <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Search by name, email, username..." />
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
                {
                    <a href="@Url.Action("Users")" class="btn btn-secondary">Clear</a>
                }
            </div>
        </form>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>
                        <a href="@Url.Action("Users", new { sortOrder = ViewBag.CurrentSort == "name_desc" ? "name_asc" : "name_desc", searchString = ViewBag.CurrentFilter, page = 1 })">
                            Name
                            @if (ViewBag.CurrentSort == "name_desc")
                            {<span>▼</span> }
                            else if (ViewBag.CurrentSort == "name_asc")
                            { <span>▲</span>}
                        </a>
                    </th>
                    <th>
                        <a href="@Url.Action("Users", new { sortOrder = ViewBag.CurrentSort == "email_desc" ? "email_asc" : "email_desc", searchString = ViewBag.CurrentFilter, page = 1 })">
                            Email
                            @if (ViewBag.CurrentSort == "email_desc")
                            {<span>▼</span> }
                            else if (ViewBag.CurrentSort == "email_asc")
                            { <span>▲</span>}
                        </a>
                    </th>
                    <th>Username</th>
                    <th>
                        <a href="@Url.Action("Users", new { sortOrder = ViewBag.CurrentSort == "points_desc" ? "points_asc" : "points_desc", searchString = ViewBag.CurrentFilter, page = 1 })">
                            Points
                            @if (ViewBag.CurrentSort == "points_desc")
                            {<span>▼</span> }
                            else if (ViewBag.CurrentSort == "points_asc")
                            { <span>▲</span>}
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.LastName @user.FirstName</td>
                        <td>@user.Email</td>
                        <td>@user.Username</td>
                        <td>@user.Points</td>
                        <td>
                            <a href="@Url.Action("EditUser", new { id = user.UserId })" class="btn btn-sm btn-primary">Edit</a>
                            <a href="@Url.Action("DeleteUser", new { id = user.UserId })" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @Html.Partial("_Pagination", new ViewDataDictionary { { "ActionName", "Users" } })
    </div>
</main>