<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Ketering Planet</title>
    @Styles.Render("~/Content/css")

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.2/font/bootstrap-icons.css">
</head>

<body class="bg-light flex-column min-vh-100">
    <!-- Navbar -->
    @if (Session["Role"] != null)
    {
        String role = Session["Role"].ToString();
        switch (role)
        {
            case "User":
                Html.RenderPartial("_navbarUser");
                break;
            case "Manager":
                Html.RenderPartial("_navbarManager");
                break;
            case "Admin":
                Html.RenderPartial("_navbarAdmin");
                break;
            default:
                Html.RenderPartial("_navbarNouser");
                break;
        }
    }
    else
    {
        Html.RenderPartial("_navbarNouser");
    }

    @RenderBody()

    <!--footer-->
    <footer class="footer border-top py-3 bg-dark">
        <div class="container text-center py-3">
            <span class="text-muted">Luka Popović 569/22. Ketering služba</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
</body>
</html>
