@{ 
    int numItemsIncart = 0;
    if (Session["Cart"] != null)
    {
        var cart = Session["Cart"] as CateringAgency.Domain.CartBo;
        numItemsIncart = cart.ItemCount;
    }
}

<!-- Customer -->
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom py-4">

    <div class="container px-5">

        <!-- Brand name -->
        <a class="navbar-brand" href="#" style="font-family:'Segoe UI Black'; font-size:2em;">
            <img src="~/Images/ketering-logo-small.png" style="height:50px;">
            Ketering
        </a>

        <!-- Dropdown for smaller window -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar -->
        <div class="collapse navbar-collapse" id="navbarNavDropdown">
            <!-- Navbar items -->
            <ul class="navbar-nav ms-auto">
                <!-- ms auto is to right align the navbar items -->
                <li class="nav-item">
                    @Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })
                </li>
                <li class="nav-item">
                    @Html.ActionLink("Menu", "Index", "Menu", null, new { @class = "nav-link" })
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index","Checkout")">
                        @if (numItemsIncart > 0)
                        {
                            <span class="badge rounded-pill bg-primary">@numItemsIncart.ToString()</span>
                        }
                        <i class="bi bi-cart"></i>
                        Cart
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("MyOrders","Order")">
                        <i class="bi bi-cash-stack"></i>
                        My orders
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-fill"></i>
                        @Session["Firstname"].ToString() @Session["Lastname"].ToString()
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                        <li>@Html.ActionLink("Edit account", "EditAccount", "Account", null, new { @class = "dropdown-item" })</li>
                        <li>@Html.ActionLink("Log out", "Logout", "Account", null, new { @class = "dropdown-item" })</li>
                    </ul>
                </li>
            </ul>

        </div>
    </div>
</nav>