@model CateringAgency.Domain.FoodBo

@{
    ViewBag.Title = "DeleteFood";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-xxl-4 px-4 py-3">
    <div class="row px-0 py-0">

        <!-- Card start -->
        <div class="card mb-2 px-0 py-0">

            <div class="row">
                <img src="~/Images/delete header.jpg">
            </div>

            <div class="row g-0 d-flex align-items-center">
                <div class="col-lg">

                    <div class="card-body py-4 px-md-5">
                        @using (Html.BeginForm("DeleteFood", "AdminMenu", FormMethod.Post))
                        {
                            @Html.HiddenFor(model => model.FoodId)
                            <h4>Are you sure you want to delete <span class="text-muted">"@Model.Name"</span> ?</h4>
                            
                            <hr>

                                <!-- submit -->
                            <input type="submit" class="btn btn-danger" value="Delete">
                            <a href="@Url.Action("Index", "AdminMenu") " class="btn btn-primary">Back</a>
                        }
                    </div>

                </div>
            </div>
        </div> <!-- Card end -->

    </div>
</div>