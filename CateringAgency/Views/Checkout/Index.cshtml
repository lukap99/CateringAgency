@model CateringAgency.Domain.CartBo

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MenuLayout.cshtml";

    if (Model != null)
    {
        Model.CalculatePoints();
        Model.CalculatePrice();
        Session["CartItemsCount"] = Model.ItemCount;
    }

}

<!-- Container -->
<div class="container bg-light px-5 mb-3">
    <div class="row">

        <!-- Cart items column -->
        <div class="col py-3">

            @if (ViewBag.changeAmountMessage != null)
            {
                <div>
                    <div class="alert alert-success alert-dismissible show fade" role="alert">
                        <span type="button" class="close" data-bs-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></span>
                        <strong>Info: @ViewBag.changeAmountMessage</strong>
                    </div>
                </div>
            }
            @if (ViewBag.errorMessage != null)
            {
                <div>
                    <div class="alert alert-warning alert-dismissible show fade" role="alert">
                        <span type="button" class="close" data-bs-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></span>
                        <strong>Error: </strong> @ViewBag.errorMessage
                    </div>
                </div>
            }

            @if (Model.HasItems())
            {
                foreach (var comboMenuItem in Model.CartComboItems)
                {
                    Html.RenderPartial("_CartComboMenuItem", comboMenuItem);
                }
                foreach (var foodItem in Model.CartItems)
                {
                    Html.RenderPartial("_CartItem", foodItem);
                }
            }
            else
            {
                Html.RenderPartial("_CartEmpty");
            }


        </div>

        <!-- Sidebar -->
        @{ Html.RenderPartial("_CartSidebar", Model); }

    </div>
</div>
