@model CateringAgency.Domain.ComboMenuBo

<div class="card mb-2">

    <div class="row align-items-center">

        <div class="col-2">
            <img src="~/Images/ketering-main-page.jpg" alt="@Model.Name" style="max-width: 100%; height: auto; margin: 10px" />
        </div>

        <div class="col-3">
            <div class="card-body" style="word-wrap: break-word;">
                <h5 class="card-title">
                    @Model.Name
                    @if (Model.DiscountIsValid)
                    {<br><span class="text-warning">(@Model.DiscountAmount.ToString()% OFF!)</span>}
                </h5>
                @if (Model.HasItems())
                {
                    <p class="text-muted">
                        @Model.ListOfItems
                    </p>
                }
            </div>
        </div>

        <div class="col text-center">
            <h5>
                Items
            </h5>
            <p class="text-muted"><b>@Model.ListOfItems</b></p>
        </div>

        <div class="col text-center">

            <h5>Base price</h5>
            <h5 class="text-primary">@Model.BasePriceString RSD</h5>
            <h5>Selling price</h5>
            <h4 class="text-primary"><b>@Model.SellingPriceString RSD</b></h4>
        </div>

        <div class="col d-grid gap-2 p-5">
            <a class="btn btn-success" href="@Url.Action("EditComboMenu", "AdminMenu", new { id = Model.ComboMenuId })"><i class="bi bi-pencil-square"> Edit item</i></a>
            <a class="btn btn-danger" href="@Url.Action("DeleteComboMenu", "AdminMenu", new { id = Model.ComboMenuId })"><i class="bi bi-trash-fill"> Delete item</i></a>
        </div>

    </div>
</div>

