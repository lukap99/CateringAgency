@model CateringAgency.Domain.ComboMenuBo

@{
    ViewBag.Title = "Create combo item";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<CateringAgency.Domain.FoodBo> foodItems = new List<CateringAgency.Domain.FoodBo>();

    // Food items to add to combo menu
    if (ViewBag.Items != null)
    { foodItems = ViewBag.Items; }
}

<!-- Create combo item -->
<div class="container col-xxl-4 px-4 py-3">
    <div class="row px-0 py-0">

        <!-- Card start -->
        <div class="card mb-2 px-0">

            <div class="row">
                <img src="~/Images/combo_menu_create_header.png">
            </div>

            <div class="row g-0 d-flex align-items-center">
                <div class="col-lg">

                    <div class="card-body py-4 px-md-5">

                        @using (Html.BeginForm("CreateComboItem", "AdminMenu", FormMethod.Post))
                        {
                        <fieldset>

                            <h4>Create combo item</h4>

                            <div class="mb-3">
                                @Html.ValidationSummary(true, "Error summary:", new { @class = "text-danger" })
                            </div>

                            <div class="row mb-3">
                                <!-- Combo Item name -->
                                <div class="col">
                                    @Html.LabelFor(model => model.Name, new { @class = "form-label" })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>

                            <!-- Price -->
                            <div class="mb-3">
                                @Html.LabelFor(model => model.BasePrice, new { @class = "form-label" })
                                @Html.ValidationMessageFor(model => model.BasePrice, "", new { @class = "text-danger" })
                                <div class="input-group" style="max-width: 40%;">
                                    @Html.EditorFor(model => model.BasePrice, new { htmlAttributes = new { @type = "number", @min = "1", @Value = "1", @step = "0.01", @class = "form-control" } })
                                    <span class="input-group-text">RSD</span>
                                </div>
                            </div>

                            <!-- Discount -->
                            <div class="mb-3">
                                @Html.LabelFor(model => model.DiscountAmount, new { @class = "form-label" })
                                @Html.ValidationMessageFor(model => model.DiscountAmount, "", new { @class = "text-danger" })
                                <div class="input-group" style="max-width: 40%;">
                                    @Html.EditorFor(model => model.DiscountAmount, new { htmlAttributes = new { @min = "0", @max = "100", @Value = "0", @type = "number", @class = "form-control" } })
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>

                            <!-- Is visible -->
                            <div class="mb-3">
                                @Html.LabelFor(model => model.IsVisible, new { @class = "form-check-label" })
                                @Html.ValidationMessageFor(model => model.IsVisible, "", new { @class = "text-danger" })
                                @Html.EditorFor(model => model.IsVisible, new { htmlAttributes = new { @class = "form-check-input" } })
                            </div>

                            <!-- submit -->
                            <input type="submit" name="Submit" value="Create" id="createFood" class="btn btn-success">
                            <a href="@Url.Action("Index", "AdminMenu") " class="btn btn-primary">Back</a>
                        </fieldset>
                        }

                    </div>

                </div>
            </div>
        </div>
        <!-- Card end -->

    </div>
</div>

